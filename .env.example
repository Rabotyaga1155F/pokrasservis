# Скопируйте файл в .env.local и заполните значения для отправки заявок.
# Все переменные используются только на сервере.

# SMTP-сервер. В коде настроены порт 465 и защищённое соединение.
EMAIL_HOST=

# Почтовый аккаунт используется для авторизации SMTP и как отправитель.
EMAIL_USER=

# Пароль почтового аккаунта или пароль приложения для SMTP.
EMAIL_PASS=

# Email получателя заявок с сайта.
RECIPIENT=
